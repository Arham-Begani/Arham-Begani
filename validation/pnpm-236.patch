+test('pnpr config dependencies round trip without tarball URLs', async () => {
+  prepareEmpty()
+  const opts = {
+    ...createOpts(),
+    registryOptionsByUrl: { [registry]: { serverType: 'pnpr' as const } },
+  }
+  await resolveAndInstallConfigDeps({
+    '@pnpm.e2e/support-different-architectures': '1.0.0',
+  }, opts)
+  const lockfile = (await readEnvLockfile(process.cwd()))!
+  expect(Object.values(lockfile.packages).length).toBeGreaterThan(1)
+  for (const pkg of Object.values(lockfile.packages)) {
+    expect(pkg.resolution).not.toHaveProperty('tarball')
+    expect(pkg.resolution).toHaveProperty('integrity')
+  }
+  await opts.store.close()
+
+  const firstRoot = process.cwd()
+  prepareEmpty()
+  const freshOpts = {
+    ...createOpts(),
+    registryOptionsByUrl: opts.registryOptionsByUrl,
+    frozenLockfile: true,
+  }
+  await writeEnvLockfile(process.cwd(), lockfile)
+  await resolveAndInstallConfigDeps({
