+async fn pnpr_config_dependencies_round_trip_without_tarball_urls() {
+    let mut test_harness = harness();
+    test_harness.registry_options_by_url.insert(
+        test_harness.registry_url.clone(),
+        pnpm_lockfile::RegistryOptions {
+            server_type: Some(pnpm_lockfile::RegistryServerType::Pnpr),
+            ..Default::default()
+        },
+    );
