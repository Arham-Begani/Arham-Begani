@@ -0,0 +1,28 @@
+use super::{CommandExtra, CommandTempCwd, EnvLockfile, fs};
+use assert_cmd::prelude::*;
+
+#[test]
+fn config_dependency_lockfile_uses_declared_registry_type() {
+    let CommandTempCwd { pacquet, root, workspace, npmrc_info, .. } =
+        CommandTempCwd::init().add_mocked_registry();
+    fs::write(workspace.join("package.json"), "{}").unwrap();
+    let manifest_path = workspace.join("pnpm-workspace.yaml");
+    let mut manifest = fs::read_to_string(&manifest_path).unwrap();
+    manifest.push_str(&format!(
+        "\nregistries:\n  '{}':\n    serverType: pnpr\n    scopes: ['@pnpm.e2e']\nconfigDependencies:\n  '@pnpm.e2e/foo': 100.0.0\n",
+        npmrc_info.mock_instance.url(),
+    ));
+    fs::write(manifest_path, manifest).unwrap();
+
+    pacquet.with_arg("install").assert().success();
+
+    let env = EnvLockfile::read(&workspace).unwrap().unwrap();
+    let key = "@pnpm.e2e/foo@100.0.0".parse().unwrap();
+    dbg!(&env.packages[&key].resolution);
+    assert!(matches!(
+        env.packages[&key].resolution,
+        pnpm_lockfile::LockfileResolution::Registry(_),
+    ),);
+    assert!(workspace.join("node_modules/.pnpm-config/@pnpm.e2e/foo/package.json").is_file());
+    drop((root, npmrc_info));
+}
