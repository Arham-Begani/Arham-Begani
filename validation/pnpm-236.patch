+    let root = TempDir::new().unwrap();
+    let config_deps = BTreeMap::from([(
+        "@pnpm.e2e/support-different-architectures".to_string(),
+        clean_spec("1.0.0"),
+    )]);
+    resolve_and_install_config_deps::<SilentReporter>(
+        &config_deps, &resolver, &options(&test_harness, root.path(), false),
+    ).await.unwrap();
+
+    let env = EnvLockfile::read(root.path()).unwrap().unwrap();
+    dbg!(&env.packages);
+    assert!(env.packages.len() > 1);
+    assert!(env.packages.values().all(|package| matches!(
+        package.resolution, pnpm_lockfile::LockfileResolution::Registry(_),
+    )),);
+
+    let mut fresh_harness = harness();
+    fresh_harness.registry_options_by_url = test_harness.registry_options_by_url.clone();
+    let fresh_root = TempDir::new().unwrap();
+    install_config_deps::<SilentReporter>(
+        &env, &options(&fresh_harness, fresh_root.path(), true),
+    ).await.unwrap();
+    assert!(fresh_root.path().join(
+        "node_modules/.pnpm-config/@pnpm.e2e/support-different-architectures/package.json"
+    ).is_file(),);
+}
